<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for claude-code-mcp-bridge HTTP server.

  This makes the bridge a long-lived, system-managed daemon: launchd starts it
  at login (RunAtLoad) and restarts it if it dies (KeepAlive). It is NOT started
  by any MCP client — every client (Pi, Hermes, Cursor, ...) just connects to
  http://127.0.0.1:8787/mcp and shares one registry + one session store.

  Install:
    1. Edit the paths below for your machine (NODE_BIN, the bin path, PATH).
       PATH must include the directory of the `claude` CLI and `lark-cli`.
    2. cp this file to ~/Library/LaunchAgents/com.restry.claude-code-mcp-bridge.plist
    3. launchctl load -w ~/Library/LaunchAgents/com.restry.claude-code-mcp-bridge.plist
    4. open http://127.0.0.1:8787/  to see the dashboard.

  Manage:
    launchctl list | grep claude-code-mcp-bridge
    launchctl unload ~/Library/LaunchAgents/com.restry.claude-code-mcp-bridge.plist
    tail -f /tmp/claude-code-mcp-bridge.{out,err}.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.restry.claude-code-mcp-bridge</string>

  <key>ProgramArguments</key>
  <array>
    <!-- node binary (use the one that has `claude` on the same nvm version, or any node >= 20) -->
    <string>/Users/leway/.nvm/versions/node/v22.22.0/bin/node</string>
    <string>/Users/leway/projects/claude-code-mcp-bridge/bin/claude-code-mcp-bridge.mjs</string>
    <string>serve</string>
    <string>--port</string>
    <string>8787</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--cwd-root</string>
    <string>/Users/leway/projects</string>
    <string>--session-store</string>
    <string>/Users/leway/.claude-code-mcp-bridge/sessions.json</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- PATH must let the bridge spawn `claude` and (for notify_target) `lark-cli` -->
    <key>PATH</key>
    <string>/Users/leway/.nvm/versions/node/v22.22.0/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/claude-code-mcp-bridge.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/claude-code-mcp-bridge.err.log</string>
</dict>
</plist>
